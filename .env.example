# Copy to .env and set the local values. The public repo ships placeholders
# only, so scripts (panel, healthcheck, local-shell) read the real host from here.

# Local AstrBot Launcher core directory
ASTRBOT_CORE=C:\path\to\astrbot\core

# SSH target for the panel / healthcheck / local-shell helper, e.g.
#   MIRUKU_SSH=root@your-server-ip
MIRUKU_SSH=root@203.0.113.10

# Optional: bypass dynamic WebUI port discovery.
# ASTRBOT_DASHBOARD=http://127.0.0.1:6185
